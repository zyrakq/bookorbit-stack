# Read-aloud worker (upstream opt-in `read-aloud` profile). Shared Bearer
# token between app and worker — generate with: openssl rand -hex 32
READ_ALOUD_WORKER_TOKEN=
# Worker image (upstream publishes :latest only)
READ_ALOUD_WORKER_IMAGE=ghcr.io/bookorbit/bookorbit-read-aloud-worker:latest
# Comma-separated library roots the worker may read (must match app mounts)
READ_ALOUD_LIBRARY_ROOTS=/books
# Output size cap the app enforces on published read-aloud EPUBs (bytes)
READ_ALOUD_MAX_OUTPUT_BYTES=21474836480
