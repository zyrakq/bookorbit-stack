# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=bookorbit

# Docker image
IMAGE=ghcr.io/bookorbit/bookorbit:v3.6.0

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# App secrets (openssl rand -hex 32)
JWT_SECRET=
PODCAST_ENCRYPTION_KEY=
SETUP_BOOTSTRAP_TOKEN=

TZ=UTC
