# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, step-ca/.env.example, pgrust/.env.example, oidc/.env.example, step-ca-trust/.env.example, tts-kokoro/.env.example, read-aloud-worker/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=bookorbit

# Docker image
IMAGE=ghcr.io/bookorbit/bookorbit:3.6.0

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# App secrets (openssl rand -hex 32)
JWT_SECRET=
SETUP_BOOTSTRAP_TOKEN=

TZ=UTC
# === STEP CA CONFIGURATION ===
VIRTUAL_PORT=3000
VIRTUAL_HOST=bookorbit.local
LETSENCRYPT_HOST=bookorbit.local
LETSENCRYPT_EMAIL=john.smith@mail.com

APP_URL=https://bookorbit.local
CLIENT_URL=https://bookorbit.local
# PostgreSQL (pgrust)
POSTGRES_DB=bookorbit
POSTGRES_USER=bookorbit
POSTGRES_PASSWORD=changeme

POSTGRES_INITDB_ARGS=--encoding=UTF8

# PostgreSQL (Optional)
COMPOSE_EXTENDS=:docker-compose.db.yml
COMPOSE_FILE=docker-compose.yml${COMPOSE_EXTENDS:-}
# OIDC
## Provider (issuer URI / client ID / client secret) is configured in the
## admin settings UI and stored in the database — no env vars for it.
## Web callback: ${APP_URL}/oauth2-callback (APP_URL comes from the
## environment fragment). Kanidm issuer convention:
## https://kanidm.af/oauth2/openid/bookorbit
## Allow OIDC issuer/discovery URLs that resolve to private/local addresses.
OIDC_ALLOW_LOCAL_ISSUERS=false
# step-ca-trust extension (step-ca environment only; requires the external
# step-ca-data volume). Trust the step-ca root CA for outbound TLS.

# Path of the step-ca root CA inside the container (read-only mount of the
# external step-ca-data volume, certs/ subpath)
NODE_EXTRA_CA_CERTS=/step-ca-root/root_ca.crt
# Kokoro TTS image (upstream pins v0.8.0)
KOKORO_IMAGE=ghcr.io/remsky/kokoro-fastapi-cpu:v0.8.0
# Read-aloud worker (upstream opt-in `read-aloud` profile). Shared Bearer
# token between app and worker — generate with: openssl rand -hex 32
READ_ALOUD_WORKER_TOKEN=
# Worker image (upstream publishes :latest only)
READ_ALOUD_WORKER_IMAGE=ghcr.io/bookorbit/bookorbit-read-aloud-worker:latest
# Comma-separated library roots the worker may read (must match app mounts)
READ_ALOUD_LIBRARY_ROOTS=/books
# Output size cap the app enforces on published read-aloud EPUBs (bytes)
READ_ALOUD_MAX_OUTPUT_BYTES=21474836480