# Generated by stackbuilder from concatenated .env.example files
# Source files: base/.env.example, forwarding/.env.example, postgresql/.env.example

# === BASE CONFIGURATION ===
# Project name for Docker Compose
COMPOSE_PROJECT_NAME=bookorbit

# Docker image
IMAGE=ghcr.io/bookorbit/bookorbit:3.6.0

# Logging
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3
LOG_COMPRESS=true

# App secrets (openssl rand -hex 32)
JWT_SECRET=
SETUP_BOOTSTRAP_TOKEN=

TZ=UTC
# Forwarding
BOOKORBIT_PORT=3000
APP_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
# PostgreSQL (pgvector)
POSTGRES_DB=bookorbit
POSTGRES_USER=bookorbit
POSTGRES_PASSWORD=changeme

POSTGRES_INITDB_ARGS=--encoding=UTF8

# PostgreSQL (Optional)
COMPOSE_EXTENDS=:docker-compose.db.yml
COMPOSE_FILE=docker-compose.yml${COMPOSE_EXTENDS:-}